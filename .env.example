# Copy to .env.local and fill in. Never commit .env.local.
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=

# Models and their fallback order live in lib/llm.ts (MODELS). Any key left empty simply
# removes that provider's models from the rotation.

# The web app calls models live only when this is 1. Leave it unset on a public deployment
# so visitors replay recorded answers and cannot spend your quota. `npm run eval` ignores it.
ALLOW_LIVE=1
