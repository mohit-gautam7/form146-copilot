# Copy to .env.local and fill in. Never commit .env.local.
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=

# Optional model overrides (defaults in lib/llm.ts). Keep three different model families.
# GROQ_MODEL=openai/gpt-oss-120b
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# OPENROUTER_MODEL=google/gemma-4-31b-it:free

# The web app calls models live only when this is 1. Leave it unset on a public deployment
# so visitors replay recorded answers and cannot spend your quota. `npm run eval` ignores it.
ALLOW_LIVE=1
